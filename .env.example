# Upstash Redis (Vercel Marketplace) — https://vercel.com/marketplace/upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternativa: si la integración de Vercel inyecta las variables con prefijo KV_
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Nombre de la red WiFi (fijo, no editable desde el panel)
WIFI_SSID=WiFi del Centro Recreativo

# Hash bcrypt de la contraseña de administrador.
# Generar con: node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 12))"
ADMIN_PASSWORD_HASH=

# Secreto para el endpoint /api/health (Vercel Cron lo envía como Bearer)
CRON_SECRET=

# URL pública del proyecto (opcional; si falta se deriva del request o de VERCEL_URL)
APP_URL=
